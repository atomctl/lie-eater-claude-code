# A real session, recorded by script: the real mod, the real model. Nothing is faked.
Output demo.mp4
Output demo.gif
Set Shell zsh
Set FontSize 15
Set Width 1500
Set Height 900
Set Padding 16
Set TypingSpeed 45ms
Set Theme "OneDark"

Hide
Type "for v in ${(k)parameters[(I)CLAUDE*]}; do unset $v; done; cd ~/learning/lie-eater-try && PROMPT='$ ' && clear" Enter
Sleep 1s
Show

Type "claude" Enter
Sleep 9s
Type "/lie-eater demo" Sleep 1s Enter
Sleep 45s
Type "/check" Sleep 1s Enter
Sleep 45s
Sleep 6s
